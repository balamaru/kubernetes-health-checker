#  K8s Health Checker — konfigurasi environment

# Identitas 
CLUSTER_NAME=production

# Discord (service notifier)
# URL webhook Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISCORD_USERNAME=K8s Health Checker
DISCORD_AVATAR_URL=
# Mention saat ada temuan CRITICAL baru. Contoh: @here  atau  <@&ROLE_ID>
DISCORD_MENTION_ON_CRITICAL=
# Maksimum pesan Discord per laporan (1 pesan = maks 10 temuan)
DISCORD_MAX_MESSAGES_PER_REPORT=5
# true = notifier hanya menulis pesan ke log (untuk uji coba tanpa Discord)
NOTIFIER_DRY_RUN=false

#  Autentikasi checker -> notifier
# Shared secret; buat dengan:  openssl rand -hex 32
WEBHOOK_AUTH_TOKEN=$(openssl rand -hex 32)
# Default ke service notifier di docker-compose. Ubah bila notifier berjalan di tempat lain.
NOTIFY_WEBHOOK_URL=http://notifier:8080/webhook

# Koneksi Kubernetes (token READ-ONLY)
# token   = pakai K8S_API_SERVER + K8S_TOKEN (jalan di luar cluster, mis. docker compose)
# incluster = pakai ServiceAccount pod (deploy di dalam cluster)
K8S_AUTH_MODE=token
K8S_API_SERVER=https://10.0.0.10:6443
K8S_TOKEN=
# CA cluster dalam base64 (field certificate-authority-data di kubeconfig). Disarankan diisi.
K8S_CA_CERT=
# Hanya untuk uji coba! Mematikan verifikasi TLS API server.
K8S_INSECURE_SKIP_TLS_VERIFY=false
K8S_REQUEST_TIMEOUT=15

# Jadwal & cakupan
CHECK_INTERVAL_SECONDS=60
# Kosong = semua: cluster,nodes,pods,logs,workloads,network,storage,events
ENABLED_CHECKS=
# Dipisah koma. Kosong = semua namespace
NAMESPACES_INCLUDE=
NAMESPACES_EXCLUDE=
# Severity minimum yang dinotifikasi: info | warning | critical
MIN_SEVERITY=warning

# Ambang batas
POD_RESTART_THRESHOLD=5
POD_PENDING_MINUTES=5
POD_NOT_READY_MINUTES=5
EVENT_WINDOW_MINUTES=15
EVENT_MIN_COUNT=3
JOB_FAILED_LOOKBACK_HOURS=24
PVC_PENDING_MINUTES=5
LB_PENDING_MINUTES=10

# Pemindaian log pod Running/Ready (check "logs")
# Pod bisa terlihat Running & Ready padahal aplikasinya terus mencatat ERROR. Checker membaca log
# terbaru tiap container yang Running (read-only, pods/log) dan melapor bila error melewati ambang.
# Jendela waktu log yang dibaca tiap pemindaian
LOG_SCAN_WINDOW_MINUTES=10
# 0 = pindai setiap siklus. Isi mis. 300 untuk cluster besar agar beban API lebih ringan
LOG_SCAN_INTERVAL_SECONDS=0
# Jumlah baris error per workload+container dalam jendela waktu: >= MIN -> warning, >= CRITICAL -> critical
LOG_SCAN_MIN_ERRORS=5
LOG_SCAN_CRITICAL_ERRORS=50
LOG_SCAN_TAIL_LINES=1000
LOG_SCAN_LIMIT_BYTES=512000
# Batas container yang dipindai per siklus (sisanya bergiliran di siklus berikutnya)
LOG_SCAN_MAX_CONTAINERS=300
LOG_SCAN_CONCURRENCY=5
# Baris error yang ditampilkan sebagai contoh
LOG_SCAN_SAMPLE_LINES=8
# Namespace khusus untuk pemindaian log (di samping NAMESPACES_INCLUDE/EXCLUDE global)
LOG_SCAN_NAMESPACES_INCLUDE=
LOG_SCAN_NAMESPACES_EXCLUDE=
# Regex (Python). Kosong = pola default berbasis level log (ERROR/FATAL/panic/Traceback/"level":"error"/klog E0000)
# Catatan docker compose: tulis $ sebagai $$
LOG_SCAN_ERROR_PATTERN=
# Regex baris yang diabaikan, mis.  healthcheck|ConnectionResetError: \[Errno 104\]
LOG_SCAN_IGNORE_PATTERN=

# Perilaku notifikasi
NOTIFY_RESOLVED=true
# Kirim pengingat untuk masalah yang belum selesai setiap N menit (0 = tidak pernah)
REMINDER_INTERVAL_MINUTES=60
MAX_FINDINGS_PER_REPORT=50

# Diagnostik nyata dari cluster
# Ambil spec, event, log container (previous), kondisi node untuk tiap temuan baru
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_INCLUDE_LOGS=true
DIAGNOSTICS_LOG_TAIL_LINES=60
# Jumlah baris log yang ditampilkan di Discord (0 = tidak tampilkan)
NOTIFY_LOG_LINES=8

# Analisis & remediasi LLM
# Kosongkan LLM_PROVIDER untuk menonaktifkan. Pilihan:
#   openai             LLM_MODEL=<nama model OpenAI>
#   anthropic          LLM_MODEL=<nama model Claude>
#   gemini             LLM_MODEL=<nama model Gemini>
#   azure              LLM_BASE_URL=https://<resource>.openai.azure.com  LLM_MODEL=<nama deployment>  LLM_API_VERSION=2024-10-21
#   ollama             LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=<model yang sudah di-pull>  (tanpa API key)
#   openai-compatible  endpoint apa pun yang kompatibel OpenAI (OpenRouter, Groq, DeepSeek, Together,
#                      Mistral, vLLM, LM Studio, LiteLLM): isi LLM_BASE_URL, mis.
#                      https://openrouter.ai/api/v1 | https://api.groq.com/openai/v1 | https://api.deepseek.com/v1
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_VERSION=
# Header tambahan (JSON), mis. untuk OpenRouter: {"HTTP-Referer":"https://example.com","X-Title":"k8s-health"}
LLM_EXTRA_HEADERS=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1500
# Kosong = default model (beberapa model reasoning tidak menerima temperature)
LLM_TEMPERATURE=
# Batas analisis LLM per siklus (sisanya dianalisis saat pengingat berikutnya)
LLM_MAX_FINDINGS_PER_RUN=10
LLM_CONCURRENCY=3
LLM_MIN_SEVERITY=warning
LLM_LANGUAGE=Bahasa Indonesia
# false = log container tidak dikirim ke LLM (spec/event tetap dikirim). Rahasia selalu disamarkan.
LLM_SEND_LOGS=true
# Set false untuk mematikan LLM sementara tanpa menghapus konfigurasi
REMEDIATION_ENABLED=true

# Lain-lain
LOG_LEVEL=INFO
IMAGE_REGISTRY=local
IMAGE_TAG=1.2.0
NOTIFIER_HOST_PORT=8080
CHECKER_HOST_PORT=8081
